
{
  "name": "visualizer-desktop",
  "version": "0.2.0",
  "description": "Hyndzia Visualizer desktop application",
  "main": "main.js",
  "author": "hyndzia.net",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:portable": "electron-builder --win portable --x64 --publish never",
    "dist:nsis": "electron-builder --win nsis --x64 --publish never",
    "dist:all": "npm run dist:nsis && npm run dist:portable"
  },
  "build": {
    "appId": "net.hyndzia.visualizer",
    "productName": "Visualizer",
    "copyright": "Copyright © 2026 hyndzia.net",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "loading.html",
      "icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/Visualizer.exe",
        "to": "backend/Visualizer.exe"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "compression": "normal",
    "electronFuses": {
      "enableEmbeddedAsarIntegrityValidation": false
    },
    "win": {
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Visualizer",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "artifactName": "Visualizer-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Visualizer-${version}-Portable.${ext}",
      "requestExecutionLevel": "user",
      "unpackDirName": false
    }
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0"
  }
}
